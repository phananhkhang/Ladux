# Copy this file to .env.production on the production host and replace every
# CHANGE_ME value through the host's secret-management process.
# Never commit .env.production itself.

SPRING_PROFILES_ACTIVE=prod
DB_HOST=postgres
DB_USERNAME=akira
DB_PASSWORD=CHANGE_ME
JWT_SECRET=CHANGE_ME_32_BYTE_OR_LONGER_RANDOM_SECRET

GOOGLE_CLIENT_ID=CHANGE_ME
GOOGLE_CLIENT_SECRET=CHANGE_ME

MAIL_USERNAME=CHANGE_ME
MAIL_PASSWORD=CHANGE_ME

VNPAY_TMN_CODE=CHANGE_ME
VNPAY_HASH_SECRET=CHANGE_ME
VNPAY_PAY_URL=CHANGE_ME
VNPAY_RETURN_URL=CHANGE_ME
VNPAY_REFUND_URL=CHANGE_ME
VNPAY_IPN_URL=CHANGE_ME
VNPAY_EXPIRE_MINUTES=15

DEEPSEEK_API_KEY=CHANGE_ME
GOOGLE_GENAI_API_KEY=CHANGE_ME

APP_CORS_ALLOWED_ORIGINS=https://ladux.vn,https://admin.ladux.vn
OAUTH2_SUCCESS_REDIRECT=https://ladux.vn/auth/oauth2/success
OAUTH2_FAILURE_REDIRECT=https://ladux.vn/login?oauth2Error=true

AUTH_COOKIE_REFRESH_NAME=REFRESH_TOKEN
ADMIN_AUTH_COOKIE_REFRESH_NAME=ADMIN_REFRESH_TOKEN
AUTH_COOKIE_REFRESH_PATH=/api/v1/auth
ADMIN_AUTH_COOKIE_REFRESH_PATH=/api/v1/admin/auth
AUTH_COOKIE_SAME_SITE=Strict
AUTH_COOKIE_SECURE=true
CONTACT_RECEIVER_EMAIL=CHANGE_ME
