                            <span className="flex items-center gap-1">
                                <Lock className="w-3.5 h-3.5 text-[#00FF41]" /> Thanh toán SSL 256-bit
                            </span>
                            <span>•</span>
                            <span>Đổi trả 30 ngày</span>
                        </div>
                    </div>
                </div>
            </div>
        </main>
    );
}
