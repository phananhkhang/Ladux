                                    >
                                        Chi Tiết
                                    </button>
                                    <button
                                        onClick={() => {
                                            setSelectedProduct(laptop);
                                            navigate(productPath(laptop.id));
                                        }}
                                        className="bg-[#00FF41] text-black py-2.5 rounded-xl text-xs font-bold hover:bg-[#00cc34] transition"
